{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Momentum",
  "version": "../package.json",
  "identifier": "com.elkeipy.momentum",
  "build": {
    "frontendDist": "./web",
    "devUrl": "http://localhost:3000/momentum_card/",
    "beforeDevCommand": "npm start"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
